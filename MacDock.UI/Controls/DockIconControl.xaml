<UserControl x:Class="MacDock.UI.Controls.DockIconControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ToolTipService.InitialShowDelay="300">
    <UserControl.ToolTip>
        <ToolTip Content="{Binding Name}"/>
    </UserControl.ToolTip>
    <Grid Background="Transparent">
        <Grid.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding LaunchCommand}"/>
        </Grid.InputBindings>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="移除" Command="{Binding RemoveCommand}"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- squircle 容器：统一图标底板，CornerRadius ≈ IconSize(48) * 0.23 -->
        <Border x:Name="SquircleBorder"
                CornerRadius="11"
                BorderThickness="1">
            <Border.BorderBrush>
                <SolidColorBrush Color="White" Opacity="0.3"/>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Opacity="0.15" ShadowDepth="1" Color="Black"/>
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F5F5F7" Offset="0"/>
                    <GradientStop Color="#E8E8ED" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <!-- 内层 Image 占容器约 70% -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="70*"/>
                    <RowDefinition Height="15*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="70*"/>
                    <ColumnDefinition Width="15*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Row="1" Grid.Column="1"
                       Source="{Binding Icon}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
