<UserControl x:Class="MacDock.UI.Controls.DockIconControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ToolTipService.InitialShowDelay="300">
    <UserControl.ToolTip>
        <ToolTip Content="{Binding Name}"/>
    </UserControl.ToolTip>
    <Grid Background="Transparent">
        <Grid.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding LaunchCommand}"/>
        </Grid.InputBindings>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="移除" Command="{Binding RemoveCommand}"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- 图标容器：无底板（macOS 图标自带造型，避免双层底观感） -->
        <Border x:Name="SquircleBorder"
                CornerRadius="11"
                Background="Transparent">

            <!-- 内层 Image 占容器约 70% -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="70*"/>
                    <RowDefinition Height="15*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="70*"/>
                    <ColumnDefinition Width="15*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Row="1" Grid.Column="1"
                       Source="{Binding Icon}"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
