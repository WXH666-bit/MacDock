<UserControl x:Class="MacDock.UI.Controls.DockIconControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 名称提示由 DockWindow 的 macOS 风格气泡承担，不再使用系统 ToolTip -->
    <Grid Background="Transparent">
        <Grid.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding LaunchCommand}"/>
        </Grid.InputBindings>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="移除" Command="{Binding RemoveCommand}"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- 图标容器：无底板（macOS 图标自带造型，避免双层底观感） -->
        <Border x:Name="SquircleBorder"
                Background="Transparent">

            <!-- 内层 Image 占容器约 88%，接近 macOS 图标在槽位中的占比 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="6*"/>
                    <RowDefinition Height="88*"/>
                    <RowDefinition Height="6*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="88*"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Row="1" Grid.Column="1"
                       Source="{Binding Icon}"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
