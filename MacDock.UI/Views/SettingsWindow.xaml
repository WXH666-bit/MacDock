<Window x:Class="MacDock.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacDock 设置"
        Width="390" Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">
    <StackPanel Margin="20">
        <TextBlock Text="MacDock 设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <CheckBox IsChecked="{Binding IsAutoStart}" Content="开机自启动"/>
        <TextBlock Margin="0,8,0,12" Text="开机时自动运行 MacDock。" Foreground="Gray" FontSize="12"/>
        <Separator Margin="0,0,0,12"/>
        <CheckBox Content="隐藏 Windows 任务栏"
                  IsChecked="{Binding HideWindowsTaskbar, Mode=OneWay}"
                  IsEnabled="{Binding CanToggleTaskbar}"
                  Command="{Binding SetTaskbarVisibilityCommand}"
                  CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
        <TextBlock Margin="0,8,0,0"
                   Text="默认关闭；仅处理主显示器任务栏，并由 watchdog 在异常退出时负责恢复。"
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   FontSize="12"/>
        <TextBlock Margin="0,8,0,0"
                   Text="{Binding TaskbarError}"
                   TextWrapping="Wrap"
                   Foreground="IndianRed"
                   FontSize="12"/>
    </StackPanel>
</Window>
