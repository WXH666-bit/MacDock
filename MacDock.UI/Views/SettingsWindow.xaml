<Window x:Class="MacDock.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacDock 设置"
        Width="360" Height="200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">
    <StackPanel Margin="20">
        <TextBlock Text="MacDock 设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <CheckBox IsChecked="{Binding IsAutoStart}" Content="开机自启动"/>
        <TextBlock Margin="0,8,0,0" Text="开机时自动运行 MacDock。" Foreground="Gray" FontSize="12"/>
    </StackPanel>
</Window>
