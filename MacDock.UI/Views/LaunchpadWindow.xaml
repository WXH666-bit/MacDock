<Window x:Class="MacDock.UI.Views.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource LaunchpadOverlayBrush}"
        Foreground="{DynamicResource AppTextPrimaryBrush}"
        Opacity="0"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PageSurface"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PageSurface" Property="Background"
                                        Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="AppHover"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AppHover" Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="AppHover" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- 一处有辨识度的柔光：像桌面壁纸透过玻璃，而不是额外装饰。 -->
        <Grid.Background>
            <RadialGradientBrush Center="0.28,0.18" GradientOrigin="0.28,0.18"
                                 RadiusX="0.78" RadiusY="0.72">
                <GradientStop Color="#38486BEA" Offset="0"/>
                <GradientStop Color="#146F63D9" Offset="0.44"/>
                <GradientStop Color="#00000000" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Border x:Name="BackdropHitArea"
                Background="Transparent"
                MouseLeftButtonUp="OnBackdropClick"/>

        <Grid x:Name="LaunchpadContent"
              Margin="72,42,72,34"
              MaxWidth="1180"
              HorizontalAlignment="Center"
              Opacity="0">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="ContentScale" ScaleX="0.97" ScaleY="0.97"/>
            </Grid.RenderTransform>
            <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,0,0,18">
                <Image Source="{StaticResource MacDockLogo}"
                       Width="32" Height="32" Margin="0,0,11,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="启动台" FontSize="25" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Border Grid.Row="1" Width="430" Height="44"
                    HorizontalAlignment="Center" CornerRadius="14"
                    Background="{DynamicResource GlassSurfaceStrongBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1" Margin="0,0,0,24">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Width="16" Height="16" Margin="0,0,10,0"
                          Stroke="{DynamicResource AppTextSecondaryBrush}"
                          StrokeThickness="1.7" Stretch="Uniform"
                          Data="M9,1 A8,8 0 1 0 9,17 A8,8 0 1 0 9,1 M15,15 L21,21"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentBrush}"
                             FontSize="15" VerticalContentAlignment="Center"
                             ToolTip="输入应用名称，支持连续或模糊字符匹配"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <ItemsControl ItemsSource="{Binding VisibleApps}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource AppButton}"
                                    Command="{Binding LaunchCommand}"
                                    Width="142" Height="126"
                                    ToolTip="{Binding Name}">
                                <StackPanel Width="112">
                                    <Border Width="68" Height="68" CornerRadius="17"
                                            HorizontalAlignment="Center"
                                            Background="{DynamicResource ControlFillBrush}"
                                            BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="25" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            <Image Source="{Binding Icon}" Margin="7"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="112" FontSize="12.5"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="180" Height="3" IsIndeterminate="True"/>
                    <TextBlock Text="正在整理应用…" Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                           Text="没有找到匹配的应用"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           FontSize="15"/>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button Content="‹" Style="{StaticResource PageButton}"
                        IsEnabled="{Binding CanGoPrevious}"
                        Command="{Binding PreviousPageCommand}"/>
                <TextBlock Text="{Binding PageText}" MinWidth="70"
                           TextAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           FontSize="12"/>
                <Button Content="›" Style="{StaticResource PageButton}"
                        IsEnabled="{Binding CanGoNext}"
                        Command="{Binding NextPageCommand}"/>
            </StackPanel>

            <TextBlock Grid.Row="4" Text="{Binding Error}"
                       Foreground="{DynamicResource ErrorBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/>
        </Grid>
    </Grid>
</Window>
