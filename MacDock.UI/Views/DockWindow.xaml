<Window x:Class="MacDock.UI.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:controls="clr-namespace:MacDock.UI.Controls"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SizeToContent="WidthAndHeight">
    <Grid Margin="18">
        <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="MacDock">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="设置" Click="OnSettingsClick"/>
                    <MenuItem Header="退出" Click="OnExitClick"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Border x:Name="DockBorder"
                CornerRadius="20"
                Padding="10"
                BorderThickness="1"
                BorderBrush="#40FFFFFF"
                AllowDrop="True"
                DragOver="OnDragOver"
                Drop="OnDrop">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#8CF9F9FA" Offset="0"/>
                    <GradientStop Color="#59EDEDF0" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="2" Opacity="0.25" Color="Black"/>
            </Border.Effect>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:FishEyePanel Background="Transparent"
                                                IconSize="48" MaxScale="1.6"
                                                EffectRadius="120" Spacing="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:DockIconControl/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>
