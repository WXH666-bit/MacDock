<Window x:Class="MacDock.UI.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:controls="clr-namespace:MacDock.UI.Controls"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SizeToContent="WidthAndHeight">
    <!--
        AllowsTransparency=False（非分层窗口）才能由 DWM 合成 SYSTEMBACKDROP 亚克力。
        WindowChrome 去掉系统边框并把整个客户区交给 DWM，Win11 上呈现亚克力 + 系统圆角。
        Win10 降级路径在构造函数中切回 AllowsTransparency=True + 半透明渐变。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CaptionHeight="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="MacDock">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="设置" Click="OnSettingsClick"/>
                    <MenuItem Header="退出" Click="OnExitClick"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- 圆角与 DWM 圆角一致（约 12px）；背景仅留极淡白色渐变，模糊交给 DWM -->
        <Border x:Name="DockBorder"
                CornerRadius="12"
                Padding="8,6,8,6"
                BorderThickness="1"
                BorderBrush="#40FFFFFF"
                AllowDrop="True"
                DragOver="OnDragOver"
                Drop="OnDrop">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#12F9F9FA" Offset="0"/>
                    <GradientStop Color="#0DEDEDF0" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:FishEyePanel Background="Transparent"
                                                IconSize="48" MaxScale="1.25"
                                                EffectRadius="120" Spacing="12"
                                                UseLayoutRounding="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:DockIconControl/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>
