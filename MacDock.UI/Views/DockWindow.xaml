<Window x:Class="MacDock.UI.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:controls="clr-namespace:MacDock.UI.Controls"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SizeToContent="WidthAndHeight">
    <!--
        图标层窗口：分层透明（AllowsTransparency=True），只承载图标、名称气泡与交互；
        毛玻璃背景由独立的 DockBackdropWindow（DWM 亚克力、鼠标穿透）在下层承担。
        双窗口结构使放大的图标能溢出玻璃条上方，还原 macOS Dock 的观感。
    -->
    <Grid x:Name="RootGrid">
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="MacDock"
                        IconSource="{StaticResource MacDockTrayIcon}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Opened="OnTrayContextMenuOpened">
                    <MenuItem Header="设置" Click="OnSettingsClick"/>
                    <MenuItem Header="退出" Click="OnExitClick"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <StackPanel Orientation="Vertical">
            <!-- macOS 风格名称气泡：悬停图标上方居中，淡入淡出 -->
            <Canvas x:Name="LabelCanvas" Height="38" ClipToBounds="False">
                <Border x:Name="NameBubble"
                        CornerRadius="7"
                        Padding="11,4,11,5"
                        Background="#E0242428"
                        BorderThickness="1"
                        BorderBrush="#30FFFFFF"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.45" Color="Black"/>
                    </Border.Effect>
                    <TextBlock x:Name="NameText"
                               Foreground="#F2FFFFFF"
                               FontSize="13"
                               FontWeight="Medium"/>
                </Border>
            </Canvas>

            <!-- 近透明底色保证空隙可命中（拖放/悬停），视觉上不可见 -->
            <ItemsControl x:Name="DockItems"
                          ItemsSource="{Binding Items}"
                          Background="#01000000"
                          AllowDrop="True"
                          DragOver="OnDragOver"
                          Drop="OnDrop">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:FishEyePanel IconSize="56" MaxScale="1.6"
                                               EffectRadius="130" Spacing="8"
                                               UseLayoutRounding="True"
                                               Loaded="OnFishEyePanelLoaded"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:DockIconControl/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Window>
