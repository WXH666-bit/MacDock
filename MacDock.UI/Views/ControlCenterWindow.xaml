<Window x:Class="MacDock.UI.Views.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="350" Height="456"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="ActionTile" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background"
                                        Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tile" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Choice"
                                Background="Transparent"
                                CornerRadius="9"
                                Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Choice" Property="Background"
                                        Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Choice" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ControlCenterRoot"
            Margin="8"
            Padding="18"
            CornerRadius="22"
            Background="{DynamicResource GlassSurfaceBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1"
            Opacity="0">
        <Border.Effect>
            <DropShadowEffect Color="#66000000" BlurRadius="28" ShadowDepth="8" Opacity="0.42"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="ControlCenterTransform" Y="8"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,2,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="控制中心"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding EffectiveThemeLabel}"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           FontSize="11" VerticalAlignment="Center"/>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
                <Button Style="{StaticResource ActionTile}"
                        Command="{Binding OpenWifiSettingsCommand}"
                        Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Wi‑Fi" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="网络设置" FontSize="10"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionTile}"
                        Command="{Binding OpenBluetoothSettingsCommand}"
                        Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="蓝牙" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="设备设置" FontSize="10"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionTile}"
                        Command="{Binding OpenFocusAssistSettingsCommand}"
                        Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="专注" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="免打扰" FontSize="10"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Border Grid.Row="2" CornerRadius="15"
                    Background="{DynamicResource ControlFillBrush}"
                    Padding="14,12" Margin="0,0,0,10"
                    IsEnabled="{Binding IsAudioAvailable}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="音量" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <Button Grid.Column="1" Content="静音"
                                Command="{Binding ToggleMuteCommand}"
                                Padding="8,2" BorderThickness="0"
                                Foreground="{DynamicResource AppTextSecondaryBrush}"
                                Background="Transparent" Cursor="Hand"/>
                    </Grid>
                    <Slider Grid.Row="1" Margin="0,7,0,0"
                            Minimum="0" Maximum="100"
                            Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Border>

            <Border Grid.Row="3" CornerRadius="15"
                    Background="{DynamicResource ControlFillBrush}"
                    Padding="14,12" Margin="0,0,0,10"
                    Visibility="{Binding IsBrightnessAvailable, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="亮度" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <Slider x:Name="BrightnessSlider" Margin="0,7,0,0"
                            Minimum="0" Maximum="100"
                            Value="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" CornerRadius="15"
                    Background="{DynamicResource ControlFillBrush}"
                    Padding="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" GroupName="Theme"
                                 Content="跟随系统"
                                 Style="{StaticResource ThemeChoice}"
                                 IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                                 IsEnabled="{Binding CanChangeTheme}"
                                 Command="{Binding UseSystemThemeCommand}"/>
                    <RadioButton Grid.Column="1" GroupName="Theme"
                                 Content="浅色"
                                 Style="{StaticResource ThemeChoice}"
                                 IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                 IsEnabled="{Binding CanChangeTheme}"
                                 Command="{Binding UseLightThemeCommand}"/>
                    <RadioButton Grid.Column="2" GroupName="Theme"
                                 Content="深色"
                                 Style="{StaticResource ThemeChoice}"
                                 IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                 IsEnabled="{Binding CanChangeTheme}"
                                 Command="{Binding UseDarkThemeCommand}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="5">
                <TextBlock Text="系统项只打开 Windows 设置，不会静默改变系统状态。"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Error}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
