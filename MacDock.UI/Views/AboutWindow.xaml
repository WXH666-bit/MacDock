<Window x:Class="MacDock.UI.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于本机"
        Icon="{StaticResource MacDockLogo}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <!--
        普通可激活窗口（不加 WS_EX_NOACTIVATE）：只有 Dock 与菜单栏不抢焦点。
        深色卡片 + 圆角，与菜单栏观感一致。
    -->
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{DynamicResource GlassSurfaceStrongBrush}"
            BorderThickness="1"
            BorderBrush="{DynamicResource GlassBorderBrush}"
            MouseLeftButtonDown="OnDragArea">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.45" Color="Black"/>
        </Border.Effect>

        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,4">
                <Image Source="{StaticResource MacDockLogo}"
                       Width="34" Height="34"
                       Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MacDock"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="关于本机"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="11"/>
                </StackPanel>
            </StackPanel>

            <!-- 四项明细统一放在下方表格，标题区不重复显示 -->
            <Border Grid.Row="1" Height="18"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="处理器" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProcessorName}" Style="{StaticResource ValueStyle}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="内存" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MemoryText}" Style="{StaticResource ValueStyle}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="系统版本" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OperatingSystem}" Style="{StaticResource ValueStyle}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="主机名" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MachineName}" Style="{StaticResource ValueStyle}"/>
            </Grid>

            <Button Grid.Row="3"
                    Content="关闭"
                    Width="88" Height="30"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    Foreground="{DynamicResource AppTextPrimaryBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    Background="{DynamicResource ControlFillBrush}"
                    Cursor="Hand"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OnCloseClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
