<Window x:Class="MacDock.UI.Views.MenuBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MacDock.UI.Converters"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False">
    <Window.Resources>
        <conv:IconStateToGeometryConverter x:Key="IconToGeometry"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- 托盘图标项模板：可见区与溢出区共用，点击转发由 code-behind 处理 -->
        <DataTemplate x:Key="TrayItemTemplate">
            <Border Margin="5,0"
                    Width="24" Height="24"
                    Background="Transparent"
                    CornerRadius="5"
                    Cursor="Hand"
                    ToolTip="{Binding Tooltip}"
                    MouseLeftButtonUp="OnTrayMouseLeft"
                    MouseRightButtonUp="OnTrayMouseRight">
                <Image Source="{Binding Icon}" Width="16" Height="16"/>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <!--
        顶部菜单栏：主屏通栏，贴顶 y=0，宽度=主屏全宽。
        AllowsTransparency=False 是为了让 DWM/Accent 亚克力生效（分层窗口不支持）。
        尺寸与位置由 code-behind 用物理像素通过 SetWindowPos 落位，规避 DPI 取整露缝。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CaptionHeight="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <!-- 亚克力之上叠一层极淡渐变提亮，与 Dock 玻璃条同一套观感 -->
        <Border x:Name="GlassLayer">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#14FFFFFF" Offset="0"/>
                    <GradientStop Color="#08FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- 下边缘一根发丝分割线 -->
        <Border Height="1" VerticalAlignment="Bottom" Background="#1FFFFFFF"/>

        <Grid Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左：Logo + 前台应用名 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="LogoButton"
                        Width="22" Height="22"
                        Background="Transparent"
                        CornerRadius="5"
                        Cursor="Hand"
                        ToolTip="关于本机"
                        MouseLeftButtonUp="OnLogoClick">
                    <Image Width="16" Height="16"
                           Source="{StaticResource MacDockLogo}"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Text="{Binding ForegroundAppName}"
                           Foreground="#F2FFFFFF"
                           FontSize="13"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           MaxWidth="420"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- 右：托盘区（音量左侧）+ 控制中心（音量/亮度）+ 时间 -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <!-- 托盘区（接管任务栏托盘，TrayTakeover=false 时整块隐藏） -->
                <StackPanel x:Name="TrayRegion"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsTrayEnabled, Converter={StaticResource BoolToVisibility}}">
                    <!-- 可见托盘图标 -->
                    <ItemsControl ItemsSource="{Binding Visible}"
                                  ItemTemplate="{StaticResource TrayItemTemplate}"
                                  VerticalAlignment="Center"/>

                    <!-- 溢出 chevron（有隐藏图标时显示，点击弹 Popup） -->
                    <Border x:Name="OverflowChevron"
                            Visibility="{Binding HasOverflow, Converter={StaticResource BoolToVisibility}}"
                            Width="18" Height="24"
                            Background="Transparent"
                            CornerRadius="4"
                            Cursor="Hand"
                            ToolTip="隐藏的图标"
                            MouseLeftButtonUp="OnChevronClick">
                        <!-- 上折角箭头（^）：矢量 Path -->
                        <Path Width="9" Height="9"
                              Stretch="Uniform"
                              Fill="#D9FFFFFF"
                              Data="M0.5,6 L4.5,2 L8.5,6 L7.3,7.2 L4.5,4.4 L1.7,7.2 Z"/>
                    </Border>

                    <!-- 溢出图标弹层：StaysOpen=False 点外部自动关，背景深色卡片与音量浮窗一致 -->
                    <Popup x:Name="OverflowPopup"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=OverflowChevron}"
                           HorizontalOffset="-8" VerticalOffset="4">
                        <Border CornerRadius="10"
                                Background="#F2242428"
                                BorderThickness="1"
                                BorderBrush="#26FFFFFF"
                                Padding="8,10"
                                Margin="0,4,0,0">
                            <ItemsControl ItemsSource="{Binding Overflow}"
                                          ItemTemplate="{StaticResource TrayItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" MaxWidth="240"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- 亮度（不支持时整个隐藏） -->
                <Border x:Name="BrightnessIcon"
                        Visibility="{Binding IsBrightnessAvailable, Converter={StaticResource BoolToVisibility}}"
                        Width="26" Height="24"
                        Background="Transparent"
                        CornerRadius="5"
                        Cursor="Hand"
                        ToolTip="亮度"
                        MouseLeftButtonUp="OnBrightnessClick"
                        MouseWheel="OnBrightnessWheel">
                    <!-- 太阳：四芒星，代表亮度调节 -->
                    <Path Width="15" Height="15"
                          Stretch="Uniform"
                          Fill="#F2FFFFFF"
                          Data="M12,4 L13.7,10.3 L20,12 L13.7,13.7 L12,20 L10.3,13.7 L4,12 L10.3,10.3 Z"/>
                </Border>

                <!-- 音量：喇叭图标 + 百分比（无音频设备时整块隐藏，与亮度图标语义一致） -->
                <Border x:Name="VolumeIcon"
                        Visibility="{Binding IsAudioAvailable, Converter={StaticResource BoolToVisibility}}"
                        Width="26" Height="24"
                        Background="Transparent"
                        CornerRadius="5"
                        Cursor="Hand"
                        ToolTip="音量"
                        MouseLeftButtonUp="OnVolumeClick"
                        MouseWheel="OnVolumeWheel">
                    <Path Width="15" Height="15"
                          Stretch="Uniform"
                          Fill="#F2FFFFFF"
                          Data="{Binding VolumeIconState, Converter={StaticResource IconToGeometry}}"/>
                </Border>

                <TextBlock Text="{Binding VolumePercent}"
                           Visibility="{Binding IsAudioAvailable, Converter={StaticResource BoolToVisibility}}"
                           Foreground="#D9FFFFFF"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           MinWidth="28"/>

                <!-- 右：时间 -->
                <TextBlock Text="{Binding ClockText}"
                           Foreground="#F2FFFFFF"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
