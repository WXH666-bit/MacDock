<Window x:Class="MacDock.UI.Views.MenuBarFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MacDock.UI.Converters"
        Width="200"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        ResizeMode="NoResize">
    <!--
        音量/亮度共用浮窗：从菜单栏图标正下方弹出，150ms 上移淡入。
        普通可激活小窗（不加 NOACTIVATE）：点外部 Deactivated 自动收起，简单可靠。
        背景复用 Accent 亚克力，深色圆角卡片与「关于本机」一致。
    -->
    <Window.Resources>
        <conv:IconStateToGeometryConverter x:Key="IconToGeometry"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:MuteLabelConverter x:Key="MuteLabel"/>

        <!-- 静音按钮：圆角描边小按钮，与「关于本机」关闭按钮同观感 -->
        <Style x:Key="FlyoutMuteButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="FlyoutRoot"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="FlyoutTransform"/>
        </Grid.RenderTransform>
        <Border CornerRadius="10"
                Background="{DynamicResource GlassSurfaceStrongBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource GlassBorderBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.4" Color="Black"/>
            </Border.Effect>

            <StackPanel Margin="16,14,16,14">
                <!-- 头部：图标 + 标题 + 百分比 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Path Width="16" Height="16"
                          Stretch="Uniform"
                          Fill="{DynamicResource AppTextPrimaryBrush}"
                          Data="{Binding IconState, Converter={StaticResource IconToGeometry}}"/>
                    <TextBlock Text="{Binding Title}"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </StackPanel>

                <!-- 垂直滑条（macOS 控制中心风格） -->
                <Slider x:Name="ValueSlider"
                        Orientation="Vertical"
                        Height="140"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        ToolTip="{Binding Value, StringFormat={}{0:0}%}">
                    <Slider.Resources>
                        <Style TargetType="{x:Type Thumb}">
                            <Setter Property="Height" Value="16"/>
                            <Setter Property="Width" Value="16"/>
                        </Style>
                    </Slider.Resources>
                </Slider>

                <!-- 底部：静音按钮（仅音量模式） + 百分比 -->
                <Grid Margin="0,12,0,0">
                    <Button x:Name="MuteButton"
                            Visibility="{Binding ShowMuteButton, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource FlyoutMuteButton}"
                            Content="{Binding IsMuted, Converter={StaticResource MuteLabel}}"
                            Command="{Binding ToggleMuteCommand}"
                            HorizontalAlignment="Center"
                            Cursor="Hand"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
