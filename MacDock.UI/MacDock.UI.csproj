<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>12</LangVersion>
    <RootNamespace>MacDock.UI</RootNamespace>
    <AssemblyName>MacDock</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.0.131" />
    <PackageReference Include="NLog" Version="6.2.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.30" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacDock.Core\MacDock.Core.csproj" />
    <ProjectReference Include="..\MacDock.Animations\MacDock.Animations.csproj" />
    <ProjectReference Include="..\MacDock.Watchdog\MacDock.Watchdog.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- 内置 macOS 风格图标（pack URI 访问：pack://application:,,,/Assets/Icons/*.png） -->
    <Resource Include="Assets\Icons\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <Target Name="CopyWatchdogOutput" AfterTargets="Build">
    <PropertyGroup>
      <WatchdogOutputDirectory>$(MSBuildProjectDirectory)\..\MacDock.Watchdog\bin\$(Configuration)\$(TargetFramework)\</WatchdogOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <WatchdogRequiredOutput Include="$(WatchdogOutputDirectory)MacDock.Watchdog.exe" />
      <WatchdogRequiredOutput Include="$(WatchdogOutputDirectory)MacDock.Watchdog.dll" />
      <WatchdogRequiredOutput Include="$(WatchdogOutputDirectory)MacDock.Watchdog.deps.json" />
      <WatchdogRequiredOutput Include="$(WatchdogOutputDirectory)MacDock.Watchdog.runtimeconfig.json" />
      <WatchdogOptionalOutput Include="$(WatchdogOutputDirectory)MacDock.Watchdog.pdb"
                              Condition="Exists('$(WatchdogOutputDirectory)MacDock.Watchdog.pdb')" />
    </ItemGroup>
    <Error Condition="!Exists('$(WatchdogOutputDirectory)MacDock.Watchdog.exe')"
           Text="MacDock.Watchdog.exe was not built." />
    <Error Condition="!Exists('$(WatchdogOutputDirectory)MacDock.Watchdog.dll')"
           Text="MacDock.Watchdog.dll was not built." />
    <Error Condition="!Exists('$(WatchdogOutputDirectory)MacDock.Watchdog.deps.json')"
           Text="MacDock.Watchdog.deps.json was not built." />
    <Error Condition="!Exists('$(WatchdogOutputDirectory)MacDock.Watchdog.runtimeconfig.json')"
           Text="MacDock.Watchdog.runtimeconfig.json was not built." />
    <Copy SourceFiles="@(WatchdogRequiredOutput);@(WatchdogOptionalOutput)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
