<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 10.0.22621 平台版本：内置 WinRT 投影，供 StoreAppResolver 使用 PackageManager -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>12</LangVersion>
    <RootNamespace>MacDock.Core</RootNamespace>
    <AssemblyName>MacDock.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.30" />
    <PackageReference Include="NLog" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
